# Text files are UTF-8. Enforce with EditorConfig charset=utf-8 and ../scripts/check-utf8.py.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.ipa binary
*.icns binary
*.ttf binary
*.otf binary
