+package che.glucosemonitorbe.assistant.chat;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import org.junit.jupiter.api.Test;
+
+class AssistantPromptsTest {
+
+    @Test
+    void qualitativeContextDetection() {
+        assertTrue(AssistantPrompts.isQualitativeContext("I underestimated carbs"));
+        assertTrue(AssistantPrompts.isQualitativeContext(
+                "Sushi has lots of protein, so it has delayed rising"));
+        assertFalse(AssistantPrompts.isQualitativeContext("What should I do?"));
+        assertFalse(AssistantPrompts.isQualitativeContext("How is my IOB"));
+        assertFalse(AssistantPrompts.isQualitativeContext(null));
+    }
+
+    @Test
+    void questionPromptInstructsZeroNumbersForAcknowledgments() {
+        String prompt = AssistantPrompts.question(
+                FactsPayload.builder().language("en").build(),
+                "I underestimated carbs",
+                java.util.List.of());
+        assertTrue(prompt.contains("ZERO numbers"), prompt);
+        assertTrue(prompt.contains("underestimated carbs"), prompt);
+        assertTrue(prompt.contains("Never issue imperative dosing commands"), prompt);
+    }
+
+    @Test
+    void qualitativeTemplateAcknowledgesWithoutReliabilityDump() {
+        FactsPayload facts = FactsPayload.builder().language("en")
+                .state(FactsPayload.State.builder().glucose(7.2).glucoseAt("12:05").iob(1.0).cob(10.0).build())
+                .build();
+        String text = AssistantPrompts.questionTemplate(facts, "I underestimated carbs");
+        assertTrue(text.contains("Got it"), text);
+        assertFalse(text.contains("Right now: glucose"), text);
+        assertFalse(text.contains("I could not answer this reliably"), text);
+        assertTrue(che.glucosemonitorbe.ai.NumberGuard.check(text, facts).ok());
+    }
+
+    @Test
+    void doseQuestionStillGetsReliabilityTemplate() {
+        FactsPayload facts = FactsPayload.builder().language("en")
+                .state(FactsPayload.State.builder().glucose(7.2).glucoseAt("12:05").iob(1.0).cob(10.0).build())
+                .build();
+        String text = AssistantPrompts.questionTemplate(facts, "What should I do?");
+        assertTrue(text.contains("Right now: glucose"), text);
+        assertTrue(text.contains("I could not answer this reliably"), text);
+    }
+}
