<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIcons</key>
	<dict/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of your meal to log it with your glucose reading.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Not used.</string>
	<key>com.apple.developer.arkit</key>
	<true/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Meal photos are saved to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a meal photo from your library to analyze its nutrition.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.che.glucosemonitor.background-refresh</string>
	</array>
</dict>
</plist>
